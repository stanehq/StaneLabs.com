NODE_ENV=development
PORT=3001
HOST=0.0.0.0
# Exactly one frontend origin, with no trailing slash or path.
FRONTEND_ORIGIN=http://127.0.0.1:3000
# Leave blank when directly exposed. Set only the real reverse proxy IP/subnet.
# For a reverse proxy on this host: TRUST_PROXY=loopback
TRUST_PROXY=
# Optional compiled Next.js export directory. Default: backend/public
WEB_ROOT=

# Contact remains unavailable until all SMTP credentials below are configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SECURITY_EMAIL=security@stanelabs.com
