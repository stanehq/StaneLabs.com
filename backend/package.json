{
  "name": "@stanelabs/backend",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && node --watch dist/main.js",
    "watch": "tsc -p tsconfig.json --watch",
    "start": "node dist/main.js",
    "test": "npm run build && node --test test/*.test.cjs"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/throttler": "6.7.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "nodemailer": "10.0.16",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
