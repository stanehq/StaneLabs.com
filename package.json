{
  "name": "stanelabs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": ["backend"],
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "dev:visual": "vite --host 127.0.0.1",
    "dev:api": "npm run dev --workspace backend",
    "build": "node scripts/seo.mjs && next build --webpack && node scripts/finalize-next.mjs && node scripts/seo.mjs --dist && node scripts/verify.mjs && npm run build --workspace backend",
    "build:visual": "vite build && tsx scripts/prerender.tsx",
    "preview": "vite preview --host 127.0.0.1",
    "start": "node backend/dist/main.js"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "feather-icons": "^4.29.2",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^24.7.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  }
}
